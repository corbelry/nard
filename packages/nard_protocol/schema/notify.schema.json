{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nardarena.app/schema/notify.json",
  "title": "Notify",
  "type": "object",
  "required": [
    "notifications"
  ],
  "properties": {
    "notifications": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "userId",
          "notification"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "maxLength": 64
          },
          "notification": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        }
      }
    }
  }
}
