{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/core/**",
              "components/game/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|IBM Plex Sans|IBM Plex Sans Condensed|Noto Serif Display))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, IBM Plex Sans, IBM Plex Sans Condensed, Noto Serif Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|pressed|sub|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, pressed, sub, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:l|m|s)$/]",
        "message": "<Button> size must be one of 'l' | 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checker'] > JSXAttribute > JSXIdentifier[name!=/^(?:side|size|selected|colorBlind|count|style|key|ref|className|style|children)$/]",
        "message": "<Checker> doesn't accept that prop. Declared props: side, size, selected, colorBlind, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checker'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:ivory|onyx)$/]",
        "message": "<Checker> side must be one of 'ivory' | 'onyx'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Clock'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|delay|delaySeconds|state|style|key|ref|className|style|children)$/]",
        "message": "<Clock> doesn't accept that prop. Declared props: time, delay, delaySeconds, state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Clock'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|active|low)$/]",
        "message": "<Clock> state must be one of 'idle' | 'active' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurrencyPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|amount|key|ref|className|style|children)$/]",
        "message": "<CurrencyPill> doesn't accept that prop. Declared props: kind, amount."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurrencyPill'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:coin|gem)$/]",
        "message": "<CurrencyPill> kind must be one of 'coin' | 'gem'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Die'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|state|style|key|ref|className|style|children)$/]",
        "message": "<Die> doesn't accept that prop. Declared props: value, size, state, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Die'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|rolling|used)$/]",
        "message": "<Die> state must be one of 'idle' | 'rolling' | 'used'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|caption|round|tone|size|children|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, caption, round, tone, size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|accent|danger)$/]",
        "message": "<IconButton> tone must be one of 'default' | 'accent' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initials|flag|rating|rank|tier|pip|clock|delay|active|low|offline|trailing|key|ref|className|style|children)$/]",
        "message": "<PlayerCard> doesn't accept that prop. Declared props: name, initials, flag, rating, rank, tier, pip, clock, delay, active, low, offline, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerCard'] > JSXAttribute[name.name='flag'] > Literal[value!=/^(?:az|tr|ru)$/]",
        "message": "<PlayerCard> flag must be one of 'az' | 'tr' | 'ru'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerCard'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:bronze|silver|gold|platinum|diamond|master|grandmaster)$/]",
        "message": "<PlayerCard> tier must be one of 'bronze' | 'silver' | 'gold' | 'platinum' | 'diamond' | 'master' | 'grandmaster'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|height|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, tone, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|sub|size|showLabel|key|ref|className|style|children)$/]",
        "message": "<RankBadge> doesn't accept that prop. Declared props: tier, sub, size, showLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankBadge'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:bronze|silver|gold|platinum|diamond|master|grandmaster)$/]",
        "message": "<RankBadge> tier must be one of 'bronze' | 'silver' | 'gold' | 'platinum' | 'diamond' | 'master' | 'grandmaster'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RankBadge'] > JSXAttribute[name.name='sub'] > Literal[value!=/^(?:I|II|III)$/]",
        "message": "<RankBadge> sub must be one of 'I' | 'II' | 'III'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RarityFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:rarity|name|status|equipped|locked|children|width|key|ref|className|style|children)$/]",
        "message": "<RarityFrame> doesn't accept that prop. Declared props: rarity, name, status, equipped, locked, children, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='RarityFrame'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:common|rare|epic|legendary|seasonal)$/]",
        "message": "<RarityFrame> rarity must be one of 'common' | 'rare' | 'epic' | 'legendary' | 'seasonal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|scrim|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: title, children, scrim."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sub|tone|ornament|key|ref|className|style|children)$/]",
        "message": "<StatusBanner> doesn't accept that prop. Declared props: title, sub, tone, ornament."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brass|dim|danger|ok)$/]",
        "message": "<StatusBanner> tone must be one of 'brass' | 'dim' | 'danger' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|onChange|label|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: on, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onChange|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:home|tour|clan|store|profile)$/]",
        "message": "<TabBar> active must be one of 'home' | 'tour' | 'clan' | 'store' | 'profile'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
